{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@zl3avr/avr-core": [
        "../avr-core/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test"
  ]
}
